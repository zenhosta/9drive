MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=9drive
MYSQL_USER=9drive
MYSQL_PASSWORD=change-this-database-password

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Set to false to stop new sign-ups (email and Google) once your account exists.
# The first account on a fresh install can always be created and becomes the admin.
ALLOW_REGISTRATION=true

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=
