MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=9drive
MYSQL_USER=9drive
MYSQL_PASSWORD=change-this-database-password

# Host address the frontend (5173) and backend (4000) ports listen on.
# 127.0.0.1 keeps them reachable only from this machine (use a reverse proxy to publish them).
# Set 0.0.0.0 to expose them on every network interface.
BIND_ADDRESS=127.0.0.1

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=
